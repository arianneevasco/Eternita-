# Copy to .env for local backend development. Never commit real values.

# HTTP server
PORT=3000

# Firebase Admin: use ADC when FIREBASE_KEY_PATH is unset.
# Optional explicit project ID (replace placeholder with your Firebase project ID).
FIREBASE_PROJECT_ID=your-firebase-project-id
# Optional server-side service-account JSON path. Keep the file out of Git.
# FIREBASE_KEY_PATH=./firebase/serviceAccountKey.json
# Optional standard ADC credential file path (server only; never give its file to frontend).
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/server-credentials.json

# Optional local Firestore emulator (Firebase CLI normally sets this for emulator scripts).
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Server-only Gemini credential. Replace locally; never put in frontend config.
GEMINI_API_KEY=REPLACE_WITH_SERVER_SIDE_GEMINI_API_KEY

# Optional delayed death-report confirmation; defaults to 2 minutes.
DEATH_REPORT_CONFIRMATION_DELAY_MINUTES=2
